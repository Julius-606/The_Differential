# This is an example .env file.
# For local development, you can copy this to a file named .env and fill in your actual secrets.
# Make sure to add .env to your .gitignore file to prevent committing secrets to your repository.

# Gemini API Keys (comma-separated, no spaces around commas)
GEMINI_KEYS="YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2"

# Telegram Bot Token for the Orbit script
TELEGRAM_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"